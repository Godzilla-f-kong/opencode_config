+test("private storage writes files when directory fsync is unavailable", async () => {
+    const root = mkdtempSync(join(tmpdir(), "better-compact-write-"))
+    const path = join(root, "state.json")
+
+    await writePrivateFile(path, '{"ok":true}', root)
+
+    assert.equal(readFileSync(path, "utf8"), '{"ok":true}')
+})
+
+test("directory fsync is disabled only on Windows", () => {
+    assert.equal(supportsDirectorySync("win32"), false)
